# Application
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=todo_api
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=20

# CORS
CORS_ORIGIN=*

# JWT Authentication
# Generate a secure secret using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-secret-key-here-replace-with-strong-random-value
JWT_EXPIRES_IN=7d
